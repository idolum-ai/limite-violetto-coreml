nhancements, clean ups and optimizations.\r\n\r\n\r\nSpecial thanks to our external contributors for this release:\r\n@orena1 , @M-Quadra, @noobsiecoder, @metascroy, @hasn77, @Pranaykarvi\r\n","reactions":{"url":"https://api.github.com/repos/apple/coremltools/releases/261258968/reactions","total_count":23,"+1":5,"-1":0,"laugh":0,"hooray":18,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":6}